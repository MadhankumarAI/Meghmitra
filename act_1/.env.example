# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- service ---
ADMIN_API_KEY=change-me-long-random          # X-API-Key for every non-webhook route. Required before tunnelling.
DEV_MODE=true                                # /dev/phone simulator (local requests only, refused via tunnel)
CORS_ORIGINS=http://localhost:3000           # officer console origin(s), comma separated
ALLOW_EXPIRED_ADVISORIES=true                # fixtures are dated June-July 2026; set false for real use
PUBLIC_BASE_URL=                             # https://<NGROK_DOMAIN>
NGROK_AUTH_TOKEN=                            # free account at dashboard.ngrok.com
NGROK_DOMAIN=                                # your free static domain, e.g. name.ngrok-free.dev

# --- WhatsApp: Meta Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WHATSAPP_MODE=simulator                      # simulator | cloud
WA_PHONE_ID=                                 # "Phone number ID" of the test number
WA_TOKEN=                                    # temporary (24 h) or system-user access token
WA_VERIFY_TOKEN=                             # any string; paste the same into the webhook config
WA_APP_SECRET=                               # App settings > Basic > App secret (verifies webhook signatures)
WA_APP_ID=

# --- demo recipients used by fixtures/subscribers.json (${DEMO_PHONE_1} etc.) ---
DEMO_PHONE_1=+91XXXXXXXXXX                   # your phone: Kannada farmer in Kundgol
DEMO_PHONE_2=                                # a Hindi-speaking tester (Sehore)
DEMO_PHONE_3=                                # a Kannada farmer in Navalgund
DEMO_OFFICER_PHONE=                          # the Kundgol officer

# --- offline content tools ---
HF_TOKEN=                                    # Hugging Face read token (AI4Bharat gated models)
DATAGOVIN_API_KEY=                           # optional: India Post PIN directory from data.gov.in
